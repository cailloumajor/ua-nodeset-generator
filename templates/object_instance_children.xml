{#- Renders nothing if there are no children, otherwise starts with a line break. -#}
{%- if !objects.is_empty() %}
<opc:Children>
  {%- for object in objects.iter() %}
  <opc:Object SymbolicName="{{ object.name }}" TypeDefinition="{{ object.object_type }}">
    <opc:Description>{{ object.description }}</opc:Description>
    {%- if !object.objects.is_empty() %}
      {{- self.nested(object.objects.as_slice()) | indent(4) | safe }}
    {%- endif %}
  </opc:Object>
  {%- endfor %}
</opc:Children>
{%- endif %}

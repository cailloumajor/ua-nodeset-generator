<?xml version="1.0" encoding="utf-8" ?>

<opc:ModelDesign
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:opc="http://opcfoundation.org/UA/ModelDesign.xsd"
  xmlns:ua="http://opcfoundation.org/UA/"
  xmlns:uax="http://opcfoundation.org/UA/2008/02/Types.xsd"
  {%- for (key, url, _) in ns_dependencies %}
  xmlns:{{ key }}="{{ url }}"
  {%- endfor %}
  xmlns="{{ ns_url }}"
  TargetNamespace="{{ ns_url }}"
  TargetVersion="{{ ns_version }}"
  TargetPublicationDate="{{ ns_pub_date }}"
>

  <opc:Namespaces>
    <opc:Namespace Prefix="{{ ns_prefix }}">{{ ns_url }}</opc:Namespace>
    {%- for (key, url, prefix) in ns_dependencies %}
    <opc:Namespace Prefix="{{ prefix }}">{{ url }}</opc:Namespace>
    {%- endfor %}
  </opc:Namespaces>

  <!-- Namespace metadata according to OPC-UA v1.04. -->
  <opc:Object SymbolicName="{{ ns_metadata_obj_name }}" TypeDefinition="ua:NamespaceMetadataType" PartNo="12">
    <opc:BrowseName>{{ ns_url }}</opc:BrowseName>
    <opc:Children>
      <opc:Property SymbolicName="ua:NamespaceUri" DataType="ua:String">
        <opc:DefaultValue>
          <uax:String>{{ ns_url }}</uax:String>
        </opc:DefaultValue>
      </opc:Property>
      <opc:Property SymbolicName="ua:NamespaceVersion" DataType="ua:String">
        <opc:DefaultValue>
          <uax:String>{{ ns_version }}</uax:String>
        </opc:DefaultValue>
      </opc:Property>
      <opc:Property SymbolicName="ua:NamespacePublicationDate" DataType="ua:DateTime">
        <opc:DefaultValue>
          <uax:DateTime>{{ ns_pub_date }}</uax:DateTime>
        </opc:DefaultValue>
      </opc:Property>
      <opc:Property SymbolicName="ua:IsNamespaceSubset" DataType="ua:Boolean">
        <opc:DefaultValue>
          <uax:Boolean>false</uax:Boolean>
        </opc:DefaultValue>
      </opc:Property>
      <opc:Property SymbolicName="ua:StaticNodeIdTypes" DataType="ua:IdType" ValueRank="Array" />
      <opc:Property SymbolicName="ua:StaticNumericNodeIdRange" DataType="ua:NumericRange" ValueRank="Array" />
      <opc:Property SymbolicName="ua:StaticStringNodeIdPattern" DataType="ua:String" />
      <opc:Property SymbolicName="ua:DefaultRolePermissions" DataType="ua:RolePermissionType" ValueRank="Array"/>
      <opc:Property SymbolicName="ua:DefaultUserRolePermissions" DataType="ua:RolePermissionType" ValueRank="Array"/>
      <opc:Property SymbolicName="ua:DefaultAccessRestrictions" DataType="ua:AccessRestrictionType"/>
    </opc:Children>
    <opc:References>
      <opc:Reference IsInverse="true">
        <opc:ReferenceType>ua:HasComponent</opc:ReferenceType>
        <opc:TargetId>ua:Server_Namespaces</opc:TargetId>
      </opc:Reference>
    </opc:References>
  </opc:Object>

{%- for root_element in root_elements %}
  {%- if let Some(object_type) = root_element.as_object_type() %}

  <opc:ObjectType SymbolicName="{{ object_type.name }}" {# Keep a whitespace #}
    {%- if let Some(base_type) = object_type.base_type -%}
      BaseType="{{ base_type }}"
    {%- else -%}
      BaseType="ua:BaseObjectType"
    {%- endif -%}
    {%- if object_type.is_abstract -%}
      {# Keep a whitespace #} IsAbstract="true"
    {%- endif -%}
  >
    <opc:Description>{{ object_type.description }}</opc:Description>
    {%- if !object_type.children.is_empty() %}
    <opc:Children>
    {%- for child in object_type.children %}
    {%- if let Some(var) = child.as_variable() %}
      <opc:Property SymbolicName="{{ var.name }}" DataType="ua:{{ var.data_type }}" AccessLevel="{{ var.access_level }}"
        {%- if let Some(dimensions) = var.array_dimensions -%}
          {# Keep a whitespace #} ValueRank="Array" ArrayDimensions="{{ dimensions | join(',') }}"
        {%- endif -%}
      >
        <opc:Description>{{ var.description }}</opc:Description>
      </opc:Property>
    {%- else if let Some(object) = child.as_object() %}
      <opc:Object SymbolicName="{{ object.name }}" TypeDefinition="{{ object.object_type }}"
        {%- if let Some(modelling_rule) = object.modelling_rule -%}
          {# Keep a whitespace #} ModellingRule="{{ modelling_rule }}"
        {%- endif -%}
      >
        {%- if let Some(browse_name) = object.browse_name() %}
        <opc:BrowseName>{{ browse_name }}</opc:BrowseName>
        {%- endif %}
        <opc:Description>{{ object.description }}</opc:Description>
      </opc:Object>
    {%- endif %}
    {%- endfor %}
    </opc:Children>
    {%- endif %}
  </opc:ObjectType>
  {%- else if let Some(object_instance) = root_element.as_object_instance() %}

  <opc:Object SymbolicName="{{ object_instance.name }}" TypeDefinition="{{ object_instance.object_type }}">
    {{- self.instance_children(object_instance.objects.as_slice())|safe }}
    <opc:References>
      <opc:Reference IsInverse="true">
        <opc:ReferenceType>ua:Organizes</opc:ReferenceType>
        <opc:TargetId>ua:ObjectsFolder</opc:TargetId>
      </opc:Reference>
    </opc:References>
  </opc:Object>

  {%- endif %}
{%- endfor %}

</opc:ModelDesign>


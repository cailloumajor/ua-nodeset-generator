<?xml version="1.0" encoding="utf-8" ?>

<opc:ModelDesign
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:opc="http://opcfoundation.org/UA/ModelDesign.xsd"
  xmlns:ua="http://opcfoundation.org/UA/"
  xmlns:uax="http://opcfoundation.org/UA/2008/02/Types.xsd"
  xmlns:base="urn:testns:base"
  xmlns="urn:testns:derived"
  TargetNamespace="urn:testns:derived"
  TargetVersion="0.3.1"
  TargetPublicationDate="2011-12-13T19:15:16Z"
>

  <opc:Namespaces>
    <opc:Namespace Prefix="Opc.Ua.Derived">urn:testns:derived</opc:Namespace>
    <opc:Namespace Prefix="Opc.Ua.Base">urn:testns:base</opc:Namespace>
  </opc:Namespaces>

  <!-- Namespace metadata according to OPC-UA v1.04. -->
  <opc:Object SymbolicName="OpcUaDerivedNamespaceMetadata" TypeDefinition="ua:NamespaceMetadataType" PartNo="12">
    <opc:BrowseName>urn:testns:derived</opc:BrowseName>
    <opc:Children>
      <opc:Property SymbolicName="ua:NamespaceUri" DataType="ua:String">
        <opc:DefaultValue>
          <uax:String>urn:testns:derived</uax:String>
        </opc:DefaultValue>
      </opc:Property>
      <opc:Property SymbolicName="ua:NamespaceVersion" DataType="ua:String">
        <opc:DefaultValue>
          <uax:String>0.3.1</uax:String>
        </opc:DefaultValue>
      </opc:Property>
      <opc:Property SymbolicName="ua:NamespacePublicationDate" DataType="ua:DateTime">
        <opc:DefaultValue>
          <uax:DateTime>2011-12-13T19:15:16Z</uax:DateTime>
        </opc:DefaultValue>
      </opc:Property>
      <opc:Property SymbolicName="ua:IsNamespaceSubset" DataType="ua:Boolean">
        <opc:DefaultValue>
          <uax:Boolean>false</uax:Boolean>
        </opc:DefaultValue>
      </opc:Property>
      <opc:Property SymbolicName="ua:StaticNodeIdTypes" DataType="ua:IdType" ValueRank="Array" />
      <opc:Property SymbolicName="ua:StaticNumericNodeIdRange" DataType="ua:NumericRange" ValueRank="Array" />
      <opc:Property SymbolicName="ua:StaticStringNodeIdPattern" DataType="ua:String" />
      <opc:Property SymbolicName="ua:DefaultRolePermissions" DataType="ua:RolePermissionType" ValueRank="Array"/>
      <opc:Property SymbolicName="ua:DefaultUserRolePermissions" DataType="ua:RolePermissionType" ValueRank="Array"/>
      <opc:Property SymbolicName="ua:DefaultAccessRestrictions" DataType="ua:AccessRestrictionType"/>
    </opc:Children>
    <opc:References>
      <opc:Reference IsInverse="true">
        <opc:ReferenceType>ua:HasComponent</opc:ReferenceType>
        <opc:TargetId>ua:Server_Namespaces</opc:TargetId>
      </opc:Reference>
    </opc:References>
  </opc:Object>

  <opc:ObjectType SymbolicName="PalletPayloadType" BaseType="base:PayloadType">
    <opc:Description>Represents a pallet carried through a port</opc:Description>
    <opc:Children>
      <opc:Property SymbolicName="PalletNumber" DataType="ua:UInt16" AccessLevel="ReadWrite">
        <opc:Description>Number of the pallet</opc:Description>
      </opc:Property>
      <opc:Property SymbolicName="Destinations" DataType="ua:UInt16" AccessLevel="ReadWrite" ValueRank="Array" ArrayDimensions="8">
        <opc:Description>Successive destinations of the pallet</opc:Description>
      </opc:Property>
    </opc:Children>
  </opc:ObjectType>

  <opc:ObjectType SymbolicName="BarcodeReaderType" BaseType="ua:BaseObjectType">
    <opc:Description>Represents a barcode reader</opc:Description>
    <opc:Children>
      <opc:Property SymbolicName="LastCode" DataType="ua:String" AccessLevel="Read">
        <opc:Description>Last barcode read</opc:Description>
      </opc:Property>
    </opc:Children>
  </opc:ObjectType>

  <opc:ObjectType SymbolicName="PalletPortType" BaseType="base:PortType">
    <opc:Description>Represents a port handling pallets</opc:Description>
    <opc:Children>
      <opc:Object SymbolicName="Payload" TypeDefinition="PalletPayloadType">
        <opc:Description>Pallet at the port</opc:Description>
      </opc:Object>
    </opc:Children>
  </opc:ObjectType>

  <opc:Object SymbolicName="Station1" TypeDefinition="base:MotorizedEquipmentType">
    <opc:Children>
      <opc:Object SymbolicName="InputPort" TypeDefinition="PalletPortType">
        <opc:Children>
          <opc:Object SymbolicName="BarcodeReader" TypeDefinition="BarcodeReaderType" />
        </opc:Children>
      </opc:Object>
      <opc:Object SymbolicName="OutputPort" TypeDefinition="PalletPortType" />
    </opc:Children>
    <opc:References>
      <opc:Reference IsInverse="true">
        <opc:ReferenceType>ua:Organizes</opc:ReferenceType>
        <opc:TargetId>ua:ObjectsFolder</opc:TargetId>
      </opc:Reference>
    </opc:References>
  </opc:Object>

</opc:ModelDesign>

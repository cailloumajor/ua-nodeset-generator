{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Namespace",
  "description": "Source description of an OPC-UA namespace for ModelDesign XML generation.",
  "type": "object",
  "properties": {
    "dependencies": {
      "description": "Namespaces this namespace depends on, mapped by prefix.\n\nEach value is the path of the dependency description file, relative to the\ndirectory of this description file. The prefix is used to reference the elements\nof the dependency (e.g. `prefix:MotorType`). The dependency must have been\ngenerated beforehand, as its NodeSet file is used.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "namespace_url": {
      "description": "Namespace URL.",
      "type": "string"
    },
    "publication_date": {
      "description": "Namespace publication date and time.",
      "type": "string",
      "format": "date-time"
    },
    "root_elements": {
      "description": "Root elements of this namespace.",
      "type": "array",
      "items": {
        "description": "A namespace root element.",
        "oneOf": [
          {
            "title": "ObjectTypeElement",
            "description": "ObjectType description.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "object_type"
              }
            },
            "$ref": "#/$defs/ObjectType",
            "required": [
              "type"
            ]
          },
          {
            "title": "ObjectInstanceElement",
            "description": "ObjectType instance description.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "object_instance"
              }
            },
            "$ref": "#/$defs/ObjectInstance",
            "required": [
              "type"
            ]
          }
        ]
      }
    },
    "version": {
      "description": "Version to set on the generated nodeset.",
      "type": "string"
    }
  },
  "required": [
    "namespace_url",
    "version",
    "publication_date",
    "root_elements"
  ],
  "$defs": {
    "AccessLevel": {
      "description": "The access level of the variable.\n\nThis is a subset of [available levels].\n\n[available levels]: https://reference.opcfoundation.org/specs/OPC-10000-3/8.57",
      "type": "string",
      "enum": [
        "Read",
        "Write",
        "ReadWrite"
      ]
    },
    "ModellingRule": {
      "description": "Modelling rule of an object component.\n\nFor placeholders, the browse name of the object is its name enclosed in angle\nbrackets (e.g. `<Motor>`).",
      "type": "string",
      "enum": [
        "Mandatory",
        "Optional",
        "MandatoryPlaceholder",
        "OptionalPlaceholder"
      ]
    },
    "ObjectComponent": {
      "description": "Source description of an object component of an ObjectType.",
      "type": "object",
      "properties": {
        "description": {
          "description": "Description of the object.",
          "type": "string"
        },
        "modelling_rule": {
          "description": "[Modelling rule] of the object, `Mandatory` if omitted.\n\n[Modelling rule]: https://reference.opcfoundation.org/specs/OPC-10000-3/6.4.4",
          "anyOf": [
            {
              "$ref": "#/$defs/ModellingRule"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "description": "Name of the object.",
          "type": "string"
        },
        "object_type": {
          "description": "Name of the ObjectType of the object, prefixed for an ObjectType of a dependency\n(e.g. `prefix:MotorType`).",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "object_type"
      ]
    },
    "ObjectInstance": {
      "description": "Source description of an instance of an ObjectType.\n\nAn instance at the root of the namespace is organized in the `Objects` folder,\nother instances are components of their parent instance.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name of the object instance.",
          "type": "string"
        },
        "object_type": {
          "description": "Name of the ObjectType of this instance, prefixed for an ObjectType of a\ndependency (e.g. `prefix:MotorType`).",
          "type": "string"
        },
        "objects": {
          "description": "Object instances to add to this instance, as components.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectInstance"
          }
        }
      },
      "required": [
        "name",
        "object_type"
      ]
    },
    "ObjectType": {
      "description": "Source description of an OPC-UA ObjectType for ModelDesign XML generation.",
      "type": "object",
      "properties": {
        "base_type": {
          "description": "Name of the ObjectType this one derives from, prefixed for an ObjectType of a\ndependency (e.g. `prefix:DeviceType`). Defaults to `BaseObjectType`.",
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "description": "Children of the ObjectType, in declaration order.",
          "type": "array",
          "items": {
            "description": "A child of an ObjectType.",
            "oneOf": [
              {
                "title": "VariableChild",
                "description": "Variable description, as a property.",
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "variable"
                  }
                },
                "$ref": "#/$defs/Variable",
                "required": [
                  "type"
                ]
              },
              {
                "title": "ObjectChild",
                "description": "Object description, as a component.",
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "object"
                  }
                },
                "$ref": "#/$defs/ObjectComponent",
                "required": [
                  "type"
                ]
              }
            ]
          }
        },
        "description": {
          "description": "Description of the ObjectType.",
          "type": "string"
        },
        "is_abstract": {
          "description": "Whether the ObjectType is abstract, i.e. cannot be instantiated.",
          "type": "boolean",
          "default": false
        },
        "name": {
          "description": "Name of the ObjectType (e.g. `MotorType`).",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ]
    },
    "ScalarDataType": {
      "description": "OPC-UA scalar data types that can be used for variables.\n\nThe set of types has been chosen arbitrarily.",
      "type": "string",
      "enum": [
        "Boolean",
        "SByte",
        "Byte",
        "Int16",
        "UInt16",
        "Int32",
        "UInt32",
        "Int64",
        "UInt64",
        "Float",
        "Double",
        "String",
        "DateTime",
        "Guid",
        "ByteString",
        "LocalizedText"
      ]
    },
    "Variable": {
      "description": "Source description of a variable of an ObjectType.",
      "type": "object",
      "properties": {
        "access_level": {
          "description": "Access level of the variable.",
          "$ref": "#/$defs/AccessLevel"
        },
        "array_dimensions": {
          "description": "List of [array dimensions] for the variable, which is a scalar if omitted.\n\n[array dimensions]: https://reference.opcfoundation.org/specs/OPC-10000-6/5.2.5",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "minItems": 1
        },
        "data_type": {
          "description": "OPC-UA data type of the variable.",
          "$ref": "#/$defs/ScalarDataType"
        },
        "description": {
          "description": "Description of the variable.",
          "type": "string"
        },
        "name": {
          "description": "Name of the variable.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "data_type",
        "access_level"
      ]
    }
  }
}
